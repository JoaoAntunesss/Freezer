<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121A29"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título Fixo do Widget -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Ementa do Dia"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Texto onde vai aparecer a ementa de almoço/jantar -->
    <TextView
        android:id="@+id/widgetEmentaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F1F5F9"
        android:textSize="14sp"
        android:text="A carregar ementa..." />

    <!-- Texto do alerta vermelho de descongelamento (escondido por defeito) -->
    <TextView
        android:id="@+id/widgetAlertaDescongelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#F87171"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>